# Carpool UTEC - configuracion de entorno
#
# Copia este archivo como .env y ajusta EXPO_PUBLIC_API_URL segun donde corre
# el backend. La app no tiene una URL de API por defecto en codigo.

# Web / localhost:
EXPO_PUBLIC_API_URL=http://localhost:8080/api/v1

# Emulador Android:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8080/api/v1

# Celular fisico en la misma Wi-Fi:
# EXPO_PUBLIC_API_URL=http://192.168.1.X:8080/api/v1

# Google Maps (opcional para mapas embebidos):
# EXPO_PUBLIC_GOOGLE_MAPS_KEY=
